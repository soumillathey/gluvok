[Unit]
Description=Argus ANPR FastAPI Microservice
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/combined/argus
ExecStart=/home/pi/.local/bin/uv run python main.py --server --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
